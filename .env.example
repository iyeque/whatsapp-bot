# ---------------------------------------------------------------------------------
# General Bot Configuration
# ---------------------------------------------------------------------------------
DB_PATH="./whatsapp.db"  # SQLite database path for storing bot data
HUMAN_ASSISTANT_JID="254725333825@s.whatsapp.net" # Your WhatsApp JID (e.g., 254712345678@s.whatsapp.net)
IGNORED_CHAT_JIDS="" # Comma-separated list of Chat JIDs (e.g., bot_jid1@lid,bot_jid2@s.whatsapp.net) to ignore completely. Our bot will not process or respond to messages in these chats.
WHATSAPP_LOG_LEVEL="info"  # Log level (info, debug, warn, error)
MAX_WHATSAPP_CHARS=4096  # Maximum characters per WhatsApp message
CONTEXT_WINDOW=4096  # Maximum context window size for the AI model
SUMMARY_THRESHOLD=10  # Number of messages before summarization
RATE_LIMIT_PER_SECOND=0.5  # Rate limit for message processing

# ---------------------------------------------------------------------------------
# Conversational AI Provider Selection (for chat responses)
# ---------------------------------------------------------------------------------
# Choose your main AI provider for generating chat responses.
# Options: "LOCAL", "GEMINI", "OPENAI", "GROQ"
AI_PROVIDER="LOCAL"
AI_TIMEOUT=60 

# ---------------------------------------------------------------------------------
# Option 1: Cerebras AI (High-Speed Cloud LLM)
# ---------------------------------------------------------------------------------
AI_ENDPOINT="https://api.cerebras.ai/v1/chat/completions"
MODEL_NAME="llama3.1-8b"
AI_API_KEY="" # Replace with your Cerebras AI API Key

# ---------------------------------------------------------------------------------
# STT (Speech-to-Text) Configuration
# ---------------------------------------------------------------------------------
# To use local whisper.cpp, set STT_PROVIDER="LOCAL".
STT_PROVIDER="LOCAL"
STT_ENDPOINT="http://localhost:9095/inference" # Updated port to match your local setup
# Command to start the Whisper server automatically on bot startup
# WHISPER_CMD="D:/software/whisper-bin-x64/Release/whisper-server.exe -m ggml-base.en.bin --port 9095"
# WHISPER_DIR="D:/software/whisper-bin-x64/Release"

# ---------------------------------------------------------------------------------
# TTS (Text-to-Speech) Configuration
# ---------------------------------------------------------------------------------
# Options: "LOCAL", "ELEVENLABS"
# To use local NeuTTS-Air, set TTS_PROVIDER="LOCAL".
TTS_PROVIDER="LOCAL"
TTS_ENDPOINT="http://localhost:8000/tts" # Local NeuTTS-Air server endpoint
# Command to start the TTS server automatically on bot startup
# TTS_CMD="python tts_wrapper.py"
# TTS_DIR="D:/software/local-tts/neutts-air"

# Voice Cloning for NeuTTS-Air
# Provide paths to your local reference files or their content.
TTS_REFERENCE_AUDIO="C:/path/to/your/voice_sample.wav"
TTS_REFERENCE_TEXT="This is the text that I am speaking in the reference audio file."

# ---------------------------------------------------------------------------------
# Option 1a: LOCAL LLM Provider (Ollama / LM Studio)
# ---------------------------------------------------------------------------------
AI_ENDPOINT="http://localhost:11434/v1/chat/completions" # For Ollama
# AI_ENDPOINT="http://localhost:1234/v1/chat/completions" # For LM Studio
MODEL_NAME="llama3"

# ---------------------------------------------------------------------------------
# Option 1b: LOCAL Provider (Cloud-hosted OpenAI-compatible API, e.g., Cerebras AI)
# ---------------------------------------------------------------------------------
# To use a cloud provider that offers an OpenAI-compatible API (like Cerebras AI or Together AI),
# set AI_PROVIDER="LOCAL" above and configure these:
#
# For Cerebras AI (Recommended Free/Generous Option):
#   AI_ENDPOINT="https://api.cerebras.ai/v1/chat/completions"
#   MODEL_NAME="llama3.1-8b" # Or another model like "gpt-oss-120b", "llama-3.3-70b"
#   AI_API_KEY="[Your Cerebras AI API Key]"
#
AI_ENDPOINT="https://api.cerebras.ai/v1/chat/completions"
MODEL_NAME="llama3.1-8b"
AI_API_KEY="" # Replace with your Cerebras AI API Key or other OpenAI-compatible service key

# ---------------------------------------------------------------------------------
# Option 2: GROQ AI Provider (Recommended Free & Fast Option)
# ---------------------------------------------------------------------------------
# Groq provides extremely fast inference and has a generous free tier with no credit card.
# It supports both Vision (Images) and Whisper (Audio) out of the box.
GROQ_API_KEY=""
GROQ_MODEL="llama3-70b-8192" # Options: llama-3.2-11b-vision-preview, whisper-large-v3, etc.

# ---------------------------------------------------------------------------------
# Option 3: OPENAI AI Provider (Supports Image/Voice/Chat)
# ---------------------------------------------------------------------------------
# You can now use OpenAI for both chat responses and multi-modal (image/voice) processing.
# If OPENAI_API_KEY is set, it will be prioritized for voice (Whisper) and vision (GPT-4o).
# Set AI_PROVIDER="OPENAI" above to use it for all chat responses as well.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# ---------------------------------------------------------------------------------
# Option 3: GEMINI AI Provider (Fallback for Multi-modal Support)
# ---------------------------------------------------------------------------------
# If OpenAI is not configured, Maximus uses Gemini for 'eyes and ears' (vision/audio).
GEMINI_API_KEY="" 
GEMINI_MODEL="gemini-1.5-flash"

# ---------------------------------------------------------------------------------
# Embedding Model Provider (for RAG/Semantic Search)
# ---------------------------------------------------------------------------------
# This is separate from the conversational AI. It is used to generate embeddings
# for documents and queries for Retrieval-Augmented Generation (RAG).
# Options: "LMSTUDIO", "GEMINI" (defaults to LMSTUDIO if not set)
# ---------------------------------------------------------------------------------
EMBEDDING_PROVIDER="LMSTUDIO"

# ---------------------------------------------------------------------------------
# Option 1: LM Studio Embedding Provider (Recommended Local Option)
# ---------------------------------------------------------------------------------
# To use an LM Studio-compatible server for embeddings (e.g., running nomic-embed-text),
# set EMBEDDING_PROVIDER="LMSTUDIO" above.
# Ensure your LM Studio server is running with an embedding model loaded.
#
# LM_STUDIO_EMBEDDING_URL will be derived from AI_ENDPOINT if not set,
# but it's best to set it explicitly if your embedding server is different.
#
# LM_STUDIO_EMBEDDING_URL="http://localhost:1234/v1/embeddings"
# LM_STUDIO_EMBEDDING_MODEL="nomic-embed-text" # e.g., nomic-embed-text for LM Studio
#
LM_STUDIO_EMBEDDING_URL="http://localhost:1234/v1/embeddings"
EMBEDDING_MODEL="nomic-embed-text" # Fallback/default if LM_STUDIO_EMBEDDING_MODEL is not set

# ---------------------------------------------------------------------------------
# Voice Response Configuration (ElevenLabs)
# ---------------------------------------------------------------------------------
# To enable voice note responses, provide your ElevenLabs API Key.
# Get one at: https://elevenlabs.io/
#
# ELEVENLABS_API_KEY="your-elevenlabs-api-key-here"
# ELEVENLABS_VOICE_ID="pNInz6obpgDQGcFmaJgB" # Default is 'Adam'. Use your cloned Voice ID here.
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="pNInz6obpgDQGcFmaJgB"

# ---------------------------------------------------------------------------------
# Option 2: GEMINI Embedding Provider (Fallback Paid Option)
# ---------------------------------------------------------------------------------
# To use Gemini for embeddings, set EMBEDDING_PROVIDER="GEMINI" above.
# GEMINI_API_KEY will be used for this.
# ---------------------------------------------------------------------------------